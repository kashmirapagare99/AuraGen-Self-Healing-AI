PORT=4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DB_PATH=data/auragen.db
RATE_LIMIT_PER_MIN=60
LOG_LEVEL=INFO

# auto picks Groq, then Claude, depending on which key is set. Use "rules" to switch AI off.
LLM_PROVIDER=auto

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=20
